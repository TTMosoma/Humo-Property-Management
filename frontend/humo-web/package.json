{
  "name": "humo-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve humo-web",
    "build": "ng build humo-web",
    "build:demo": "ng build humo-web --configuration production,demo",
    "watch": "ng build humo-web --watch --configuration development",
    "start:contractor": "ng serve humo-contractor --port 4320",
    "build:contractor": "ng build humo-contractor",
    "test": "ng test humo-web --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p projects/humo-contractor/tsconfig.app.json --noEmit",
    "lint": "eslint ."
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ionic/angular": "^8.8.19",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
