# Humo apps on Apache (cPanel-style hosts). Copied into every build of
# Humo Property Management and Humo Contractor (angular.json "assets").
# Single-page app: a refresh or a deep link (e.g. /platform/invoices) serves
# index.html, and Angular's router shows the page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect everything else to index.html for Angular routing
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html is never cached, so a new deployment shows at once (the other files have hashed names).
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
