# Copy to .env on the server and fill in. NEVER commit .env (doc 26 §2: keep a copy in the password manager).

# Database
POSTGRES_PASSWORD=change-me-long-random

# The first System Administrator (a @humo.co.za address). Used once, on an empty database.
BOOTSTRAP_ADMIN_EMAIL=terry@humo.co.za
BOOTSTRAP_ADMIN_NAME=Terry Mosoma

# Email (doc 25 §2 "Mail settings"): the API hands mail to our mail server.
# Port 587 + StartTls (recommended), or 465 + SslOnConnect. None only for a server on the same machine.
MAIL_HOST=mail
MAIL_PORT=587
MAIL_SECURITY=StartTls
MAIL_USERNAME=api@notify.humo.co.za
MAIL_PASSWORD=change-me
MAIL_FROM=Humo Property Management <no-reply@notify.humo.co.za>

# Fallback relay: switch on only if our own mail lands in spam (doc 26 §8).
MAIL_RELAY_ENABLED=false
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=

# SMS (doc 25 §2): Log (nothing sent) or SmsSouthAfrica.
SMS_PROVIDER=Log
# Shown to recipients where the networks allow it (at most 11 characters).
SMS_SENDER_ID=Humo
# SMSSouthAfrica API key: their control panel, Settings > API Keys (the secret is shown once).
SMS_SOUTHAFRICA_CLIENT_ID=
SMS_SOUTHAFRICA_API_SECRET=
# true: the API answers but nothing reaches a phone and nothing is charged. Start with true.
SMS_SOUTHAFRICA_TEST_MODE=true
# Delivery reports: Settings > Webhooks, URL https://pm.humo.co.za/api/webhooks/sms/smssouthafrica,
# then Activate Signatures and paste the secret here. Without it, reports are refused.
SMS_SOUTHAFRICA_WEBHOOK_SECRET=
